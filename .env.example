# App settings (equivalent to the old APPSETTINGS_JSON). Provide either
# APPSETTINGS_JSON (recommended) or individual variables below.
APPSETTINGS_JSON={"BotSettings":{"ApiToken":"REPLACE_ME","AllowedUpdates":["Message"]},"Logging":{"LogLevel":{"Default":"Information"}}}

# Database (single core_db; sessions share this database in the Python version)
DATABASE_URL=postgresql+asyncpg://rw_user:rw_password@postgres_db:5432/core_db
# Alembic sync URL (used only when running migrations outside the app)
DATABASE_URL_SYNC=postgresql://rw_user:rw_password@localhost:5432/core_db

# rw.by endpoints require no proxy for stations/trains;
# only car_places go through PROXY_MANAGER_URL
PROXY_MANAGER_URL=http://proxy-manager:8080

# Polling interval for notifications (seconds)
NOTIFICATION_POLL_INTERVAL=5

# Moderation
NOTIFICATION_MAX_CONCURRENCY=15
NOTIFICATION_MAX_RETRIES=5